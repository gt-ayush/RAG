# LLM Provider
LLM_API_KEY=
LLM_MODEL=

# LLM provider (optional; OpenAI-compatible chat completions endpoint).
# Leave unset to use the mock/in-memory baseline until a real provider is configured.
LLM_BASE_URL=
LLM_TIMEOUT_MS=

# Vector Database
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
QDRANT_COLLECTION=

# Embedding Model
EMBEDDING_MODEL=

# Embedding provider (optional; OpenAI-compatible HTTP embeddings endpoint).
# Leave unset to use the mock/in-memory baseline until a real provider is configured.
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=

# Service boundary (optional; for running the HTTP API server).
# Leave unset to use the library modules directly without a service runtime.
PORT=8080
HOST=0.0.0.0
SHUTDOWN_TIMEOUT_MS=5000

# Real provider configuration (required only when running with real adapters;
# the service fails fast with a non-secret error if these are missing).
QDRANT_COLLECTION=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=
LLM_BASE_URL=
LLM_TIMEOUT_MS=
VECTOR_DB_TIMEOUT_MS=
